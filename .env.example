# ---------------------------------------------------------------------------
# Panel configuration - copy to .env for local development, and set the same
# keys in Railway > Variables for production.
# ---------------------------------------------------------------------------

# --- Admin login -----------------------------------------------------------
# Set these on Railway so the first boot creates your admin account.
# If you leave them empty, open the panel in a browser and a "first run"
# setup screen will let you create the admin account interactively.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-password

# Set to 1 once to force the password back to ADMIN_PASSWORD on next boot.
# ADMIN_PASSWORD_RESET=0

# --- Where the admin panel lives ------------------------------------------
# Change this to a secret path to hide the panel from scanners.
ADMIN_PATH=panel

# --- Storage ---------------------------------------------------------------
# On Railway you MUST mount a volume and point DATA_DIR at it, otherwise the
# SQLite database is wiped on every deploy.
DATA_DIR=./data
# DB_PATH=./data/panel.db

# --- Links shown to end users ---------------------------------------------
# Public URL of this app. Used to build subscription links. If empty the panel
# derives it from the incoming request.
# PUBLIC_BASE_URL=https://your-app.up.railway.app

# --- Misc ------------------------------------------------------------------
# Timezone used for daily traffic resets and "days remaining" maths.
TZ_NAME=Asia/Tehran
# Admin session lifetime in days.
SESSION_DAYS=30
# PORT is provided automatically by Railway.
# PORT=8000
